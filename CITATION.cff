    title: "OpenAI Python SDK"
    url: "https://github.com/openai/openai-python"
  - type: software
    title: "feedparser"
    url: "https://github.com/kurtmckee/feedparser"
  - type: software
    title: "Pillow"
    url: "https://github.com/python-pillow/pillow"
  - type: software
    title: "Telegraph API"
    url: "https://telegra.ph/api"
