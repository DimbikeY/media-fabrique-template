# --- LLM provider (any OpenAI-compatible endpoint) ---
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   OpenRouter:https://openrouter.ai/api/v1
#   Local:     http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=                # e.g. minimax/MiniMax-M3, anthropic/claude-3.5-sonnet, etc.
LLM_MAX_TOKENS=6000            # 0 = no limit. 6000 fits long reasoning + JSON for MiniMax-M3.
# Provider-specific reasoning control. 'minimax' => send extra_body
# {use_thinking: True, reasoning_split: False} so the final answer lands
# in message.content (not reasoning_content). Leave blank for OpenAI / etc.
LLM_REASONING_HINT=
LLM_TEMPERATURE=0.6

# --- Image generation (Sprint 3) ---
# OpenAI / OpenRouter / local. Used for Plan A in image_generator.py
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Optional fallback provider (Plan B)
IMAGE_FALLBACK_BASE_URL=
IMAGE_FALLBACK_API_KEY=
IMAGE_FALLBACK_MODEL=

# --- WordPress (Sprint 4) ---
WP_BASE_URL=              # https://example.com
WP_USERNAME=              # user with author+ permissions
WP_APP_PASSWORD=          # Application Password (NOT the login password)
WP_DEFAULT_STATUS=draft    # draft | publish
WP_DEFAULT_CATEGORIES=     # comma-separated slugs, optional

# --- Telegram observability (Sprint 6.5) ---
# One bot, one private supergroup, four topics (message threads).
# Get chat_id via `getUpdates` after the bot joins the group; each
# topic's message_thread_id is the value of `message_thread_id` in the
# `result[*].message` JSON. Leave TG_BOT_TOKEN empty for dry-mode
# (useful for local dev and CI smoke tests — every push is logged only).
TELEGRAM_BOT_TOKEN=
TG_CHAT_ID=               # -100... for supergroups (e.g. -100XXXXXXXXXX)
TG_THREAD_PUBLISHED=3
TG_THREAD_FEEDBACK=5
TG_THREAD_MORNING_REPORT=7
# TG_THREAD_IDEAS removed 2026-07-20 09:26 MSK (see notes/technical/cron-jobs-layout.md)
# DD 2026-07-20 09:38 MSK: new #published_tg topic for tg-channel posts
# (similar to #published which is for WP). Receives notifications on
# both successful TG-channel pushes AND telegraph-rolled-back failures.
TG_THREAD_PUBLISHED_TG=977
TG_THREAD_DRAFTS=237
# Aggregate filter-feedback items into one push per (reason, window)
TG_FEEDBACK_AGG_WINDOW_S=300
# Operator's Telegram username (without @). The feedback_receiver only accepts
# commands from this user; messages from anyone else are ignored. This
# filter is strict — if empty, *no one* can issue commands.
TG_DD_USERNAME=your_tg_username
# Cron tz documentation (actual schedule lives in OpenClaw cron job)
TG_MORNING_REPORT_TZ=Europe/Moscow

# --- Sprint X (DD 2026-07-19 22:03): rename PUBLISH_REQUIRES_REVIEW → WP_PUBLISH_AUTO_APPROVE ---
# Bool canonical form (DD 2026-07-20 11:46 MSK): use integers 1/0 — terse,
# grep-friendly, single source of truth across `.env.example`, the live
# `/opt/<deploy-user>/.env`, and `notes/technical/env-vars-registry.md`.
# `_env_bool()` accepts the following aliases case-insensitively
# (config.py): '1', 'true', 'yes', 'on' → True; everything else → False.
# But the **documented** form for these three Sprint X bool-envs is 1/0.
# WP_PUBLISH_AUTO_APPROVE=1  → auto-publish: publisher picks status='draft'
#                                drafts directly, no manual /approve step.
# WP_PUBLISH_AUTO_APPROVE=0  → manual review: publisher only picks
#                                status='approved' drafts (DD's /approve
#                                verdict in #drafts).
WP_PUBLISH_AUTO_APPROVE=1
# Sprint X (DD 2026-07-19 21:54): TG-channel auto-publish.
# When enabled (=1), publisher.py:process_one() calls
# tg_channel_publisher.publish() right after WP publish — skips the
# /approve_tg step. Best-effort: TG failure doesn't roll back WP
# UNLESS TELEGRAPH_REQUIRED_FOR_PUBLISH=1 (see below).
# Set to 0 to revert to manual /approve_tg flow.
TG_PUBLISH_AUTO_APPROVE=0
# Sprint X (DD 2026-07-20 07:09 MSK): hard-gate WP publish on Telegraph IV.
# TELEGRAPH_REQUIRED_FOR_PUBLISH=1 → if Telegraph IV creation fails
#   (api.telegra.ph unreachable on IPv6, token revoked, 3 retries timed out)
#   AND TG_PUBLISH_AUTO_APPROVE=1, publisher.py rolls back the WP post
#   (trashes it via WP REST DELETE) and marks the draft_posts row as failed
#   with error_reason='telegraph_required_but_unavailable: <reason>'. The
#   janitor tick will move failed→draft on the next retry window so we
#   automatically retry once. Mirrors the Sprint 6d.7 'no IV → no post' rule.
# TELEGRAPH_REQUIRED_FOR_PUBLISH=0 → WP publish goes through regardless
#   of TG/Telegraph state. TG publish failures stay best-effort (current
#   Sprint X behaviour at the time of writing).
TELEGRAPH_REQUIRED_FOR_PUBLISH=1
# LLM token-to-USD ratecard used by morning_report.py
# MiniMax-M3 pay-as-you-go (2026): $0.30/M input, $1.20/M output
LLM_COST_PER_1K_PROMPT_USD=0.0003
LLM_COST_PER_1K_COMPLETION_USD=0.0012
# Bot HTTP settings (mirrors PIPE.*)
TG_HTTP_TIMEOUT_SECONDS=15
TG_HTTP_RETRIES=3
TG_HTTP_RETRY_BACKOFF_SECONDS=1.5

# --- Telegram reader channel (Sprint 6 — not used yet) ---
TELEGRAM_CHANNEL_ID=       # @channel or numeric id (future reader-facing)

# --- Sprint 6d.5: Telegra.ph Instant View integration ---
# When publishing to TG-channel (after /approve_tg), we create a mirror page
# on telegra.ph so Telegram renders Instant View inside the channel post
# (one-tap full-page reader with images, links, formatted text). Without
# these, we fall back to a regular link preview (TG still shows OG image +
# 'Open in browser' button, but no IV).
#
# Get the token once: POST https://api.telegra.ph/createAccount
#   short_name=YourBrand&author_name=Your%20Brand&author_url=https://your-domain.tld
# Save the returned `access_token` here. Re-running createAccount is OK —
# Telegra.ph will return the SAME account if short_name matches.
TELEGRA_PH_ACCESS_TOKEN=
TELEGRA_PH_AUTHOR_URL=https://your-domain.tld

# --- Sprint 9: site/domain knobs ---
# MEDIA_DISPLAY_DOMAIN is rendered as the visible label for the
# 'Еще больше...' footer link inside Telegraph mirror pages and the
# 'Наша медиаплатформа' line in TG-channel posts. Defaults to the
# TELEGRA_PH_AUTHOR_URL hostname when unset.
MEDIA_DISPLAY_DOMAIN=your-domain.tld
# TELEGRAM_WEBHOOK_BASE_URL is the public-facing URL that Telegram's
# webhook registration points at. Must match the reverse proxy in
# front of telegram_receiver.service. Format: https://your-domain.tld
# (no trailing slash, no path).
TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.tld
# Private TG supergroup for operator-only /commands (chat_administrators
# scope). Numeric chat_id, -100 prefix for supergroups. Required for
# admin commands. Leave empty if you don't need the admin scope.
TELEGRAM_ADMIN_GROUP_CHAT_ID=-100XXXXXXXXXX

# --- Sprint 6d.5: public TG channel publication (Sprint 6) ---
# Channel where the curated TG drafts land after /approve_tg. Sprint
# 6d.5 also reads candidates.url (original article) to add a clickable
# "Источник" link next to the WP "Читать полностью" link in the channel
# post. Leave empty if you don't run a curated channel.
TG_CHANNEL_ID=
TG_CHANNEL_USERNAME=        # @handle of the channel, no leading '@'
TG_THREAD_TG_VALIDATION=

# --- Pipeline ---
DB_PATH=./data/news_memory.db
LOG_LEVEL=INFO
RUN_INTERVAL_MINUTES=60
MAX_ITEMS_PER_RUN=5

# Field length caps written to items.* columns
MAX_SUMMARY_CHARS=600
MAX_BODY_CHARS=8000

# HTTP fetching
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1.5
# Override only if your feeds reject the default Safari UA
HTTP_USER_AGENT=
